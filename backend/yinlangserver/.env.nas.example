YINLANGSERVER_IMAGE=tbslantian/yinlangserver:2.2.0-4
YINLANGSERVER_STORAGE_DIR=/volume2/docker/yinlangserver
DOWNLOAD_TOKEN=
# Use the exact LXServer local account name, or _open for the guest queue.
YINLANG_QUEUE_USER=_open

# Leave blank to keep saved LXServer settings.
ADMIN_PASSWORD=
ENABLE_WEBPLAYER_AUTH=
WEBPLAYER_PASSWORD=
LX_SYNC_ADMIN_PASSWORD=
PRIVATE_MEDIA_HOSTS=
